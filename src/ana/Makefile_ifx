#FC=mpif90
#OPT=-i-dynamic
#VPATH = OMSP_L/
#FC=ifort
#FC=ifx  # commented out 2026.11.25 CC
# use ifx if ifx is available, otherwise ifort (ifort) 2026.11.25 CC
ifneq ($(shell command -v ifx 2>/dev/null),)
FC = ifx
else ifneq ($(shell command -v ifort 2>/dev/null),)
FC = ifort
else
$(error Neither ifx nor ifort is found. Run "source /opt/intel/oneapi/setvars.sh" first)
endif
OPT= -O -fpe0 -check bounds -traceback -g -qmkl=parallel

#normal solver
ftarget=active_ana.exe
fobjs= dbesj1.o dbesj0.o intde1.o m_param_ana.o hankel_takuto_L.o m_param_active_ana.o n_active_ana.o

$(ftarget) : $(fobjs)
	$(FC) $(OPT) $(fobjs) -o $(ftarget)

# rules
.SUFFIXES : .f90 .o .f
.f90.o:
	$(FC) -c $< -o $@

.f.o:
	$(FC) -c $< -o $@


clean:
	rm -f *.o
	rm -f *.mod
	rm -f *.exe
